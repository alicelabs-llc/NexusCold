{
  "schema_version": "1.0",
  "name": "TechDigital Prospect",
  "version": "6.4",
  "publisher": {
    "name": "AliceLabs LLC",
    "contact": "legal@alicelabs.site"
  },
  "website": "https://techdigital.site/",
  "license": "AL-1.0; desktop commercial use requires written authorization",
  "capabilities": [
    {
      "id": "public_enrichment",
      "runtime": "browser",
      "network": true,
      "sources": [
        "Wikidata",
        "GLEIF",
        "Google Public DNS",
        "France · Recherche d’Entreprises",
        "Noruega · Brønnøysund",
        "Finlandia · PRH / YTJ",
        "ROR · Organizaciones y empresas de investigación",
        "Crossref · Editoriales",
        "BrasilAPI · CNPJ",
        "EE. UU. · FDIC / Bancos",
        "Nueva York · Socrata / Restaurantes",
        "Reino Unido · Food Standards Agency",
        "Pick an Agency · Agencias de marketing"
      ],
      "source_catalog": "https://techdigital.site/sources.json",
      "requires_explicit_authorization": true,
      "identity_matching": "unique_exact_organization_otherwise_user_confirmation",
      "max_rows_per_run": 10000
    },
    {
      "id": "website_contacts",
      "runtime": "self_hosted_python",
      "command": [
        "python",
        "enrichment_service.py"
      ],
      "authentication": "Bearer",
      "endpoint": "/api/enrich",
      "deployed": false
    },
    {
      "id": "browser_csv_review",
      "runtime": "browser",
      "network": false,
      "file_upload": false,
      "limits": {
        "bytes": 2097152,
        "rows": 10000
      }
    },
    {
      "id": "review",
      "runtime": "local_python_cli",
      "command": [
        "python",
        "prospect_cli.py",
        "review",
        "INPUT.csv"
      ],
      "network": false
    },
    {
      "id": "mailbox_check",
      "runtime": "local_python_cli",
      "command": [
        "python",
        "prospect_cli.py",
        "run",
        "INPUT.csv",
        "--output",
        "OUTPUT.csv",
        "--mode",
        "smtp",
        "--allow-network"
      ],
      "network": true,
      "requires_explicit_authorization": true,
      "sends_email_body": false
    },
    {
      "id": "advisory_chat",
      "runtime": "configured_ollama_or_self_hosted_gateway",
      "remote_endpoint_not_deployed_by_this_site": true,
      "gateway_path": "/api/chat",
      "authentication": "Bearer token for self-hosted gateway",
      "can_execute_tools": false
    }
  ],
  "not_implemented": [
    "managed_enrichment_backend",
    "campaign_api",
    "multi_tenant_gateway",
    "native_mobile_app"
  ],
  "data_policy": "https://techdigital.site/legal/privacy/",
  "documentation": "https://techdigital.site/docs/"
}
