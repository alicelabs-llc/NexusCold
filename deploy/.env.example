# Copy to deploy/.env; choose a domain you own and point its DNS to the server.
GERMAN_DOMAIN=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
NEXUS_GERMAN_TOKEN=
NEXUS_GERMAN_MODEL=qwen3.5:4b
# Choose a tested Ollama release/digest before production; latest requires revalidation.
OLLAMA_IMAGE=ollama/ollama:latest
